<Window x:Class="Final_Exam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Final_Exam"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="5"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="5"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="False">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label>Enter Words --></Label>
            <TextBox x:Name="MyWords" Grid.Column="1"></TextBox>
            <Button Click="SelectDirectory_Button" Grid.Column="2">Select Directory</Button>
            <Button Click="Go_Button" Grid.Column="1" Grid.Row="1">Go</Button>
        </Grid>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label>Name File</Label>
            <ListBox Grid.Row="1" x:Name="MyListNameFile"></ListBox>
            <Label Grid.Column="1">File Path</Label>
            <ListBox Grid.Column="1" x:Name="MyListPathFile" Grid.Row="1"></ListBox>
            <Label Grid.Column="2">Count Word</Label>
            <ListBox x:Name="MyListCountWord" Grid.Row="1" Grid.Column="2"></ListBox>
        </Grid>
        <ProgressBar x:Name="MyProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,20,0,0" Height="30" DockPanel.Dock="Top"></ProgressBar>
        <Button Click="SaveToFile_Button" Margin="20" DockPanel.Dock="Top" VerticalAlignment="Center">Save Info To File</Button>
    </DockPanel>
</Window>
