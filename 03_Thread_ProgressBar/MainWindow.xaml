<Window x:Class="_03_Thread_ProgressBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_03_Thread_ProgressBar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ProgressBar x:Name="progress" Height="20" Margin="20" Minimum="0" Maximum="100" Value="0" Grid.Row="0"></ProgressBar>
        <Button Grid.Row="0" Grid.Column="1" Margin="20" FontSize="36" Click="Button_Click">Start</Button>
        <ListBox Grid.Row="2" x:Name="list"></ListBox>
        <StackPanel Grid.Row="1">
            <ToolBar>
                <Label Margin="15,0,15,0" FontSize="20">First Number</Label>
                <TextBox x:Name="firstN" FontSize="20" Width="100" MinWidth="50"></TextBox>
            </ToolBar>
            <ToolBar>
                <Label Margin="15,0,15,0" FontSize="20">Second Number</Label>
                <TextBox  FontSize="20" Width="100" x:Name="secondN" MinWidth="50"></TextBox>
                <Button Margin="15,0,15,0" FontSize="20" KeyDown="Button_KeyDown" Click="Button_Click_1">Enter</Button>
            </ToolBar>
            <ToolBar>
                <Button Margin="15,0,15,0" FontSize="20" Click="Button_Click_2">Clear</Button>
            </ToolBar>
        </StackPanel>
            
        <ListBox Grid.Row="2" Grid.Column="1" x:Name="list2"></ListBox>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <Button Margin="15,0,15,0" FontSize="20" Click="Button_Click_3">Fibonacci</Button>
            <Button Margin="15,0,15,0" FontSize="20" Click="Button_Click_4">Clear Fibonacci</Button>
        </StackPanel>
    </Grid>
</Window>
