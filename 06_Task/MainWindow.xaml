<Window x:Class="_06_Task.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_06_Task"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Label Margin="5">Write numb</Label>
            <TextBox x:Name="Number" Margin="5" Width="50"></TextBox>
            <Button Click="Click_Result" Margin="5">Go</Button>
        </ToolBar>
        <TextBlock FontSize="20" TextAlignment="Center" DockPanel.Dock="Top">Results</TextBlock>
        <ListBox x:Name="list"></ListBox>
    </DockPanel>
</Window>
